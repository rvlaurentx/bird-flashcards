# Copy to .env for local development (never commit .env).
# In production, set this in Vercel → Project → Settings → Environment Variables.
EBIRD_API_KEY=
# Bird sounds: free key from your xeno-canto account page.
XENO_CANTO_API_KEY=
# Set to 1 to use built-in sample data instead of calling eBird.
EBIRD_MOCK=
