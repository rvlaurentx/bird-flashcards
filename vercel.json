{
  "outputDirectory": "public",
  "functions": {
    "api/species.js": {
      "maxDuration": 30
    },
    "api/hints.js": {
      "maxDuration": 60
    },
    "api/media.js": {
      "maxDuration": 60
    },
    "api/audio.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
